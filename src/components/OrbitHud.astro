---
import { MIN_ALTITUDE, MAX_ALTITUDE } from '../scripts/orbit-navigation';
import { GAUGE } from '../scripts/orbit-hud';
import SkyCredits from './SkyCredits.astro';
// Altitude tape positions are logarithmic, matching how the camera climbs.
const position = (km: number) => (1 - Math.log(km / MIN_ALTITUDE) / Math.log(MAX_ALTITUDE / MIN_ALTITUDE)) * 100;
// Long ticks at 1, 2, 3 and 5 of each decade, each labelled with its number.
// Short ticks split each gap evenly along the tape, so spacing changes only at a
// long tick. `split` is the gap's count of round steps (25 km from 200 to 300,
// 200 km from 1K to 2K…), so each short tick sits near a round value.
const scale = [{ km: MIN_ALTITUDE, split: 2 }, { km: 200, split: 4 }, { km: 300, split: 4 }, { km: 500, split: 5 }, { km: 1000, split: 5 }, { km: 2000, split: 4 },
  { km: 3000, split: 4 }, { km: 5000, split: 5 }, { km: 10000, split: 5 }, { km: 20000, split: 4 }, { km: 30000, split: 4 }, { km: MAX_ALTITUDE, split: 0 }];
const label = (km: number) => km >= 1000 ? `${km / 1000}K` : String(km);
const short = scale.slice(0, -1).flatMap((mark, i) => Array.from({ length: mark.split - 1 }, (_, n) => position(mark.km) + (position(scale[i + 1].km) - position(mark.km)) * (n + 1) / mark.split));
// Pitch ladder: a rung every 6°, long every 30°, over the whole ±90° so it never runs out.
const ladder = Array.from({ length: 30 }, (_, i) => (i < 15 ? i + 1 : 14 - i) * 6)
  .map(deg => { const half = deg % 30 ? 2 : 5; return `M${-half} ${(-deg * GAUGE.pitch).toFixed(2)}h${half * 2}`; }).join('');
// Modifier keys as their key-cap symbols (Inter draws them); Option reads Alt off Apple keyboards.
const shift = '<kbd>⇧</kbd>', option = '<kbd class="hud-alt">⌥</kbd>';
// Lens magnifications; 1× is the 1.25 pinhole, about 30 mm full-frame.
const lensPresets = [1, 3, 10];
// The controls panel: a column per action, a lane per input. Keys come as rows
// of key and effect (a cluster laid out as on the keyboard, alternatives joined
// by "or"); each pointing device gets a line. Obvious taps are left out.
const key = (code: string, label: string) => `<kbd data-key="${code}">${label}</kbd>`;
const either = (...keys: string[]) => keys.join('<span class="help-or">or</span>');
const cluster = (...keys: string[]) => `<span class="keys-t">${keys.join('')}</span>`;
const faster: [string, string] = [key('ShiftLeft', '⇧'), 'Faster'];
const devices = [{ id: 'mouse', name: 'Mouse' }, { id: 'trackpad', name: 'Trackpad' }, { id: 'touch', name: 'Touch' }] as const;
type Group = { name: string; keys: [string, string][]; how?: Partial<Record<(typeof devices)[number]['id'], string>>; note?: string };
const flyIn = `Double-click a point to fly in; ${shift} double-click to back off.`;
const gauge = (verb: string) => `${verb} the gauge to level or flip.`;
const groups: Group[] = [
  { name: 'Fly', keys: [[cluster(key('KeyW', 'W'), key('KeyA', 'A'), key('KeyS', 'S'), key('KeyD', 'D')), ''], faster],
    how: { mouse: 'Drag Earth.', trackpad: 'Drag Earth, or scroll over it.', touch: 'Drag Earth; flick it to coast.' } },
  { name: 'Look', keys: [[cluster(key('ArrowUp', '↑'), key('ArrowLeft', '←'), key('ArrowDown', '↓'), key('ArrowRight', '→')), ''], faster],
    how: { mouse: `Drag the sky; right-drag or ${shift} drag anywhere.`, trackpad: `Scroll over the sky; ${shift} scroll anywhere.`, touch: 'Drag the sky, or two fingers anywhere.' } },
  { name: 'Closer, farther', keys: [[either(key('KeyF', 'F'), key('Equal', '+')), 'Closer'], [either(key('KeyR', 'R'), key('Minus', '−')), 'Farther'], faster],
    how: { mouse: `Wheel. ${flyIn}`, trackpad: `Pinch. ${flyIn}`, touch: 'Pinch, or double-tap and slide. Double-tap to fly in; two-finger tap to back off.' } },
  { name: 'Lens', keys: [[key('KeyZ', 'Z'), 'Zoom in'], [key('KeyX', 'X'), 'Zoom out'], faster],
    how: { mouse: `${shift} wheel.`, trackpad: `${shift} pinch.` } },
  { name: 'Roll', keys: [[key('KeyQ', 'Q'), 'Roll left'], [key('KeyE', 'E'), 'Roll right'], [key('KeyH', 'H'), 'Level or flip'], faster],
    how: { mouse: `${option} drag around the centre. ${gauge('Click')}`, trackpad: `${option} drag around the centre<span data-only="gesture">, or rotate two fingers</span>. ${gauge('Click')}`, touch: `Twist two fingers. ${gauge('Tap')}` } },
  { name: 'Orbits', keys: [[key('Digit1', '1'), 'ISS'], [key('Digit2', '2'), 'Polar'], [key('Digit3', '3'), 'High'], [key('Digit0', '0'), 'Free flight']] },
  { name: 'Time', keys: [[key('Space', 'Space'), 'Pause or play']], note: 'Speed, date and time of day are in Settings.' },
];
// One lane per input, so each sits at the same height under every action.
const lanes = [{ id: 'keys', name: 'Keyboard' }, ...devices];
---
<div class="orbit-hud" data-modality="mouse">
  <div class="hud-time" role="group" aria-label="Time">
    <button class="sky-motion hud-time-toggle" type="button" aria-label="Pause" title="Pause"><svg class="motion-play" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" data-hidden><path d="m5 3 8 5-8 5z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg><svg class="motion-pause" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
    <time class="sky-time">—</time>
    <span class="hud-time-scale" data-time-scale title="Time scale; change it in Settings">10×</span>
    <span class="time-hint" aria-hidden="true"><kbd data-key="Space">Space</kbd><span class="time-pause">Pause</span><span class="time-play">Play</span></span>
  </div>

  <nav class="hud-modes hud-list" aria-label="Camera">
    <button type="button" data-route="iss" aria-pressed="true"><kbd data-key="Digit1">1</kbd>ISS</button>
    <button type="button" data-route="polar" aria-pressed="false"><kbd data-key="Digit2">2</kbd>Polar</button>
    <button type="button" data-route="high" aria-pressed="false"><kbd data-key="Digit3">3</kbd>High</button>
    <button type="button" data-flight-mode="free" aria-pressed="false" title="Fly from here"><kbd data-key="Digit0">0</kbd>Free</button>
  </nav>

  <div class="hud-altimeter">
    <kbd class="hud-key" data-key="KeyR" aria-hidden="true">R</kbd>
    <div id="sky-altitude" class="hud-tape" role="slider" tabindex="0" aria-label="Altitude" aria-orientation="vertical" aria-valuemin={MIN_ALTITUDE} aria-valuemax={MAX_ALTITUDE} aria-valuenow="420" aria-valuetext="420 km">
      <div class="hud-scale" aria-hidden="true">
        {short.map(top => <span class="hud-tick" style={`top:${top.toFixed(3)}%`}></span>)}
        {scale.map(({ km }) => <span class="hud-tick major" style={`top:${position(km).toFixed(3)}%`}><b data-crowded={[200, 3000, 30000].includes(km) ? '' : undefined}>{label(km)}</b></span>)}
      </div>
      <div class="hud-now" aria-hidden="true"><output class="altitude-output">420 km</output></div>
    </div>
    <kbd class="hud-key" data-key="KeyF" aria-hidden="true">F</kbd>
  </div>

  <button class="hud-attitude" type="button" aria-label="Level the horizon, or turn the view over" title="Level or flip (H)">
    <svg class="gauge" viewBox="-24 -24 48 48" width="48" height="48" aria-hidden="true">
      <defs><clipPath id="hud-gauge-clip"><circle r={GAUGE.dial} /></clipPath></defs>
      <g clip-path="url(#hud-gauge-clip)"><g class="gauge-horizon">
        <rect class="gauge-ground" x="-48" y="0" width="96" height="96" />
        <line class="gauge-line" x1="-48" x2="48" y1="0" y2="0" />
        <path class="gauge-ladder" d={ladder} />
      </g></g>
      <circle class="gauge-ring" r={GAUGE.dial} />
      <path class="gauge-earth" d="" />
      <circle class="gauge-sun" r={GAUGE.sun} style={`transform: translate(0px, ${-GAUGE.sunAt}px)`} />
      <path class="gauge-wings" d="M-13 0h7l2 2.5l2 -2.5l2 2.5l2 -2.5h7" />
    </svg>
    <span class="hud-readout">
      <span>HDG <b data-attitude="heading">000°</b></span>
      <span>PIT <b data-attitude="pitch">+00°</b></span>
      <span>ROL <b data-attitude="roll">+00°</b></span>
    </span>
  </button>

  <div class="hud-dock">
    <div class="hud-lens" role="group" aria-label="Lens 1×, 30 mm">
      <div class="lens-presets">
        {lensPresets.map(zoom => <button type="button" class="lens-preset" data-lens={zoom} data-active={zoom === 1 ? '' : undefined} aria-pressed={zoom === 1 ? 'true' : 'false'} aria-label={`${zoom}× lens, ${30 * zoom} mm`}><span class="lens-number">{zoom}</span>×</button>)}
      </div>
    </div>
  </div>

  <div class="sky-controls hud-corner hud-list" hidden>
    <button type="button" popovertarget="flight-help" title="Help (?)"><kbd data-key="Slash">?</kbd>Help</button>
    <button type="button" popovertarget="sky-info" title="Info (i)"><kbd data-key="KeyI">i</kbd>Info</button>
    <button class="sky-settings-toggle" type="button" popovertarget="sky-settings" title="Settings"><svg class="hud-gear" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.7 2-.5 2.2-1.8 1-2.2-.7-2.3 4 1.7 1.5v2l-1.7 1.5 2.3 4 2.2-.7 1.8 1 .5 2.2h4.6l.5-2.2 1.8-1 2.2.7 2.3-4-1.7-1.5v-2l1.7-1.5-2.3-4-2.2.7-1.8-1-.5-2.2z" transform="translate(0 1)" /><circle cx="12" cy="12" r="3" /></svg>Settings</button>
  </div>

  <span class="hud-pulse" aria-hidden="true" hidden></span>
  <div class="hud-fpm" aria-hidden="true" hidden><svg viewBox="-18 -12 36 24" width="36" height="24"><g class="fpm-halo"><circle r="5" /><path d="M-16 0h11M5 0h11M0 -5v-6" /></g><circle r="5" /><path d="M-16 0h11M5 0h11M0 -5v-6" /></svg><span class="hud-speed"></span></div>
</div>

<div id="flight-help" class="flight-help" popover="manual" role="region" aria-labelledby="flight-help-heading" data-modality="mouse">
  <header class="help-bar">
    <h2 id="flight-help-heading" class="help-title">Controls</h2>
    <button class="help-close" type="button" popovertarget="flight-help" popovertargetaction="hide" aria-label="Close controls"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></button>
  </header>
  <div class="help-grid" style={`grid-template-columns: auto repeat(${groups.length}, auto)`}>
    {lanes.map((lane, row) => <span class="help-lane" data-lane={lane.id} style={`grid-row: ${row + 2}`}>{lane.name}</span>)}
    {groups.map((group, column) => <>
      <div class="help-head" data-column={column} style={`grid-row: 1; grid-column: ${column + 2}`}><h3>{group.name}</h3></div>
      {group.keys.length > 0 && <div class="help-cell" data-lane="keys" data-column={column} style={`grid-row: 2; grid-column: ${column + 2}`}>{group.keys.map(([keys, effect]) => <div class="help-bind"><span class="help-k" set:html={keys} />{effect && <span class="help-a">{effect}</span>}</div>)}{group.note && <p class="help-note">{group.note}</p>}</div>}
      {devices.map((device, row) => group.how?.[device.id] && <div class="help-cell" data-lane={device.id} data-column={column} style={`grid-row: ${row + 3}; grid-column: ${column + 2}`} set:html={group.how[device.id]} />)}
    </>)}
  </div>
</div>

<div id="sky-info" class="sky-info sky-dialog" popover="auto" role="dialog" aria-labelledby="sky-info-heading">
  <header class="dialog-header"><h2 id="sky-info-heading">Info</h2>
    <button class="dialog-close" type="button" popovertarget="sky-info" popovertargetaction="hide" aria-label="Close info"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></button></header>
  <p class="help-lede">Earth, its atmosphere and the night sky, rendered in real time from a replayed ISS orbit, two model orbits or free flight. Lighting follows the date and time you pick; clouds and terrain come from satellite maps, not live weather.</p>
  <section class="info-credits" aria-labelledby="info-credits-heading">
    <h3 id="info-credits-heading">Image credits</h3>
    <SkyCredits />
  </section>
</div>

<style>
  /* The HUD box ends above the docked controls panel; contain: layout makes it
     the containing block of its fixed parts, so they all move up with it, and as
     a size container its height (cqh) sizes the tape instead of the screen's. */
  .orbit-hud { --hud-glass: rgb(8 10 14 / 62%); --hud-dim: rgb(255 255 255 / 58%); --hud-accent: #d3a784; --hud-mono: 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace; --hud-top: max(12px, env(safe-area-inset-top)); --hud-left: max(12px, env(safe-area-inset-left)); --hud-right: max(12px, env(safe-area-inset-right)); --hud-bottom: max(12px, env(safe-area-inset-bottom)); position: fixed; inset: 0 0 var(--sky-inset-bottom, 0px); contain: layout; container-type: size; z-index: 4; pointer-events: none; color: #fff; font: 11px/1.35 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; transition: opacity .5s ease; }
  :global(orbital-sky:not([data-ready])) .orbit-hud { opacity: 0; }
  .hud-time, .hud-list, .hud-attitude, .hud-lens, .hud-altimeter { pointer-events: auto; }
  .orbit-hud { user-select: none; -webkit-user-select: none; }
  /* Hint text arrives as HTML, so its keys are styled globally within the HUD. */
  /* Key caps and the controls panel use a subset of Inter (public/fonts, OFL): its arrows and ⇧ ⌥ suit keys. */
  @font-face { font-family: 'Inter Subset'; src: url('/fonts/inter-subset.woff2') format('woff2'); font-weight: 400 700; font-display: swap; }
  /* Keys: inner corners all 3 px; the 2 px bottom edge gets a taller outer curve to match. */
  /* One width for every single-glyph key: the widest, ⇧ and W, plus padding and borders. */
  .orbit-hud :global(kbd), .flight-help :global(kbd) { display: inline-grid; place-items: center; min-width: calc(1.12em + 8px); height: 16px; padding: 0 3px; box-sizing: border-box; border: 1px solid rgb(255 255 255 / 30%); border-bottom-width: 2px; border-radius: 4px 4px 4px 4px / 4px 4px 5px 5px; color: #fff; font: 500 10px/1 'Inter Subset', -apple-system, BlinkMacSystemFont, sans-serif; text-transform: none; letter-spacing: 0; vertical-align: baseline; transition: background-color .08s, color .08s, transform .08s, border-color .08s; }
  /* A held key, and the active camera preset, look pressed. */
  .orbit-hud :global(kbd[data-pressed]), .hud-list [aria-pressed="true"] kbd { background: #fff; border-color: #fff; color: #000; transform: translateY(1px); }
  /* Without a keyboard, key caps mean nothing. */
  .orbit-hud:not([data-keyboard]) .hud-key, .orbit-hud:not([data-keyboard]) .time-hint, .orbit-hud:not([data-keyboard]) .hud-list kbd { display: none; }
  /* Plain translucent fills; a backdrop blur over the live canvas costs frames and leaves artefacts. */
  .hud-time { background: var(--hud-glass); }
  button { font: inherit; color: inherit; cursor: pointer; }
  /* Focus shows as a fill, never a frame. */
  :is(button, [role="slider"]):focus-visible { outline: none; }

  /* Replay clock: Space or the button pauses it. */
  .hud-time { position: fixed; top: var(--hud-top); left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 10px; height: 36px; padding: 0 10px 0 4px; box-sizing: border-box; border-radius: 12px; font: 600 10px/1 var(--hud-mono); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hud-time-toggle { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 9px; background: rgb(255 255 255 / 10%); }
  .hud-time-toggle:is(:hover, :focus-visible) { background: rgb(255 255 255 / 22%); }
  .hud-time-toggle svg[data-hidden] { display: none; }
  .hud-time-scale { color: var(--hud-dim); }
  .time-hint { display: flex; align-items: center; gap: 5px; color: var(--hud-dim); font-weight: 500; }
  .time-play, :global(orbital-sky[data-paused]) .time-pause { display: none; }
  :global(orbital-sky[data-paused]) .time-play { display: inline; }

  /* Camera presets and free flight, top right above the altitude tape: no plate,
     keys flush with the screen edge like R and F, names to their left. */
  .hud-list { display: grid; justify-items: end; }
  .hud-modes { position: fixed; right: var(--hud-right); top: var(--hud-top); }
  /* Settings, help and info in the lower-right corner, set like the presets; settings has no key, so a gear. */
  .hud-corner { position: fixed; right: var(--hud-right); bottom: var(--hud-bottom); }
  .hud-corner[hidden] { display: none; }
  /* White like the key caps beside it, whatever the label does. */
  .hud-gear { flex: 0 0 16px; color: #fff; }
  .hud-list button { display: flex; flex-direction: row-reverse; align-items: center; gap: 8px; height: 24px; padding: 0 0 0 12px; border: 0; background: none; color: var(--hud-dim); font: 600 10px/1 var(--hud-mono); letter-spacing: .06em; text-transform: uppercase; }
  /* Not a segmented control: no fills; the active preset's key looks pressed and its name turns white. */
  .hud-list button:is(:hover, :focus-visible, [aria-pressed="true"]) { color: #fff; }

  /* The lens sits alone at the bottom centre. */
  .hud-dock { position: fixed; left: var(--hud-left); right: var(--hud-right); bottom: var(--hud-bottom); display: flex; justify-content: center; align-items: flex-end; gap: 8px; pointer-events: none; }


  /* Horizon gauge and its readouts; click to level, again to turn over. Outside
     the dial, 3 px off it, an arc points to Earth and a ring to the Sun. */
  /* At the middle of the left edge, plain like the tape and presets on the right. */
  .hud-attitude { position: fixed; left: var(--hud-left); top: 50%; transform: translateY(-50%); display: grid; grid-template-columns: auto auto; align-items: center; column-gap: 12px; padding: 0; border: 0; background: none; color: #fff; text-align: left; }
  .gauge { overflow: visible; }
  .gauge-horizon { transform: rotate(var(--roll, 0deg)) translateY(var(--pitch, 0px)); transition: transform .06s linear; }
  .gauge-ground { fill: rgb(211 167 132 / 26%); }
  .gauge-line { stroke: #fff; stroke-width: 1.2; }
  .gauge-ladder { stroke: rgb(255 255 255 / 45%); stroke-width: .8; }
  .gauge-ring { fill: none; stroke: rgb(255 255 255 / 40%); stroke-width: 1; }
  .gauge-earth { fill: none; stroke: var(--hud-accent); stroke-width: 1.5; stroke-linecap: round; }
  .gauge-sun { fill: none; stroke: #fff; stroke-width: 1.2; transition: transform .25s ease-out; }
  /* A Sun behind the camera shows faint. */
  .gauge-sun[data-behind] { opacity: .4; }
  .gauge-sun[hidden] { display: none; }
  .gauge-wings { fill: none; stroke: var(--hud-accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .hud-readout { display: grid; gap: 1px; color: var(--hud-dim); font: 500 9px/12px var(--hud-mono); letter-spacing: .05em; white-space: nowrap; }
  .hud-readout b { font-weight: 600; font-variant-numeric: tabular-nums; }

  /* Logarithmic altitude tape at the right edge; drag it, scroll over it, or use R and F.
     Marks sit left of the axis; the reading is plain text right of it. */
  /* --tick-end sets the ticks in from the edge that R and F share. */
  .hud-altimeter { --axis: 112px; --tick-end: 3px; position: fixed; right: var(--hud-right); top: 50%; transform: translateY(-50%); display: grid; justify-items: start; gap: 10px; }
  /* R and F end flush with the axis. */
  .hud-key { justify-self: end; }
  .hud-tape { --alt: 82%; position: relative; width: calc(var(--axis) + 1px); height: clamp(180px, calc(46cqh - 70px), 360px); cursor: ns-resize; touch-action: none; }
  /* No axis line: the ticks' right ends draw it. */
  .hud-scale { position: absolute; inset: 0; z-index: 1; }
  /* Short and long ticks differ only in length. */
  .hud-tick { position: absolute; right: var(--tick-end); width: 6px; height: 1px; background: rgb(255 255 255 / 50%); }
  .hud-tick.major { width: 12px; }
  .hud-tick b { position: absolute; right: 17px; top: -6px; color: rgb(255 255 255 / 66%); font: 500 9px/12px var(--hud-mono); white-space: nowrap; }
  .hud-tick b, .hud-now output { text-shadow: 0 0 3px rgb(0 0 0 / 85%), 0 0 1px rgb(0 0 0 / 90%); }
  /* The reading: plain text beyond the labels, joined to the axis by a rule that
     passes under them. Hover or focus fills it opaque orange. */
  .hud-now { position: absolute; left: 0; right: 0; top: var(--alt); height: 0; color: #fff; }
  .hud-now::before { content: ''; position: absolute; right: var(--tick-end); top: 0; width: calc(42px - var(--tick-end)); height: 1px; background: currentColor; }
  .hud-now output { position: absolute; right: 42px; top: -9px; padding: 2px 6px; border-radius: 4px; color: inherit; font: 700 10px/14px var(--hud-mono); letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hud-tape:is(:hover, :focus-visible) .hud-now { color: var(--hud-accent); }
  .hud-tape:is(:hover, :focus-visible) .hud-now output { background: var(--hud-accent); color: #000; text-shadow: none; }

  /* Lens presets, set like the camera presets: grey names, the lit one white and
     showing the exact magnification. */
  .lens-presets { display: flex; }
  .lens-preset { height: 24px; padding: 0 6px; border: 0; background: none; color: var(--hud-dim); font: 600 10px/24px var(--hud-mono); letter-spacing: .06em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .lens-preset:is(:hover, :focus-visible), .lens-preset[data-active] { color: #fff; }

  .hud-fpm { position: fixed; left: 0; top: 0; display: flex; align-items: center; gap: 4px; color: var(--hud-accent); pointer-events: none; transform: translate(calc(var(--x, -100px) - 18px), calc(var(--y, -100px) - 12px)); }
  .hud-fpm[hidden] { display: none; }
  .hud-fpm svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
  /* A dark halo drawn under the marker instead of a per-frame filter. */
  .hud-fpm .fpm-halo { stroke: rgb(0 0 0 / 55%); stroke-width: 3.5; }
  .hud-speed { text-shadow: 0 0 3px rgb(0 0 0 / 80%); font: 600 9px/1 var(--hud-mono); letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hud-pulse[hidden] { display: none; }
