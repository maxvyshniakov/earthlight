---
import { MIN_ALTITUDE, MAX_ALTITUDE } from '../scripts/flight-navigation';
import { GAUGE, LENS_MIN, LENS_MAX, EV_MIN, EV_MAX, SPEED_MAX, speedFraction } from '../scripts/flight-hud';
import SceneCredits from './SceneCredits.astro';
// Altitude tape positions are logarithmic, matching how the camera climbs.
const position = (km: number) => (1 - Math.log(km / MIN_ALTITUDE) / Math.log(MAX_ALTITUDE / MIN_ALTITUDE)) * 100;
// Long ticks at 1, 2, 3 and 5 of each decade, each labelled with its number.
// Short ticks split each gap evenly along the tape, so spacing changes only at a
// long tick. `split` is the gap's count of round steps (25 km from 200 to 300,
// 200 km from 1K to 2K…), so each short tick sits near a round value.
const scale = [{ km: MIN_ALTITUDE, split: 2 }, { km: 200, split: 4 }, { km: 300, split: 4 }, { km: 500, split: 5 }, { km: 1000, split: 5 }, { km: 2000, split: 4 },
  { km: 3000, split: 4 }, { km: 5000, split: 5 }, { km: 10000, split: 5 }, { km: 20000, split: 4 }, { km: 30000, split: 4 }, { km: MAX_ALTITUDE, split: 0 }];
const label = (km: number) => km >= 1000 ? `${km / 1000}K` : String(km);
const splits = (marks: { at: number; split: number }[]) => marks.slice(0, -1).flatMap((mark, i) => Array.from({ length: mark.split - 1 }, (_, n) => mark.at + (marks[i + 1].at - mark.at) * (n + 1) / mark.split));
const short = splits(scale.map(({ km, split }) => ({ at: position(km), split })));
// The lens tape mirrors it on the left: LENS_MIN× to LENS_MAX×, logarithmic. Long
// ticks follow the 1-2-5 series, nearly even on a log scale with both ends
// labelled; short ticks keep one pitch along the whole tape, about a sixth of an octave.
const lensPosition = (zoom: number) => (1 - Math.log(zoom / LENS_MIN) / Math.log(LENS_MAX / LENS_MIN)) * 100;
const lensScale = [{ zoom: LENS_MIN, split: 6 }, { zoom: 1, split: 6 }, { zoom: 2, split: 8 }, { zoom: 5, split: 6 }, { zoom: 10, split: 6 }, { zoom: 20, split: 8 }, { zoom: LENS_MAX, split: 0 }];
const lensShort = splits(lensScale.map(({ zoom, split }) => ({ at: lensPosition(zoom), split })));
// Exposure compensation, a short linear tape over the lens tape: whole stops
// labelled, thirds between.
const evPosition = (ev: number) => (EV_MAX - ev) / (EV_MAX - EV_MIN) * 100;
const evStops = Array.from({ length: EV_MAX - EV_MIN + 1 }, (_, i) => EV_MIN + i);
const evThirds = evStops.slice(0, -1).flatMap(ev => [ev + 1 / 3, ev + 2 / 3]);
const evLabel = (ev: number) => ev === 0 ? '0' : `${ev > 0 ? '+' : '−'}${Math.abs(ev)}`;
// Time scale, date and time of day as tapes along the top. The time scale runs
// from 0× (stopped) to 1000× in five equal stretches, each labelled, with a
// tick every sixth of one.
const speedMarks = [0, .1, 1, 10, 100, SPEED_MAX];
const speedTicks = Array.from({ length: 29 }, (_, i) => i + 1).filter(i => i % 6).map(i => i / 30);
// The date runs over a common year, January to January: month starts long, the
// 11th and 21st short, every third month labelled, about evenly. The closing
// January belongs to the next year, so a press snaps to the first one only.
const monthStarts = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334, 365];
const dayTicks = monthStarts.slice(0, -1).flatMap(day => [day + 10, day + 20]);
const months: Record<number, string> = { 0: 'Jan', 90: 'Apr', 181: 'Jul', 273: 'Oct', 365: 'Jan' };
// Time of day in UTC: every half hour, long and labelled every three hours.
const halfHours = Array.from({ length: 49 }, (_, i) => i * 30);
// Pitch ladder: a rung every 6°, long every 30°, over the whole ±90° so it never runs out.
// Sun and Moon markers, pictograms that only show a direction and never turn:
// a ten-pointed star whose rays meet at right angles, and a full crescent
// opening up and to the right, with blunt horns. For square tips the inner radius is 1 / (sin + cos) of
// half the angle between rays, of the outer.
const SUN_RAYS = 10, sunInner = 1 / (Math.sin(Math.PI / SUN_RAYS) + Math.cos(Math.PI / SUN_RAYS));
const sunStar = Array.from({ length: 2 * SUN_RAYS }, (_, i) => { const a = i * Math.PI / SUN_RAYS - Math.PI / 2, r = (i % 2 ? sunInner : 1) * GAUGE.sun; return `${i ? 'L' : 'M'}${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`; }).join('') + 'Z';
// The crescent: a 3.2 disc less a 2.55 disc 1.75 up and to its right, each horn
// rounded by a curve through where the two circles meet.
const crescent = 'M2.96 1.22A3.2 3.2 0 1 1 -0.69 -3.12Q-0.15 -3.20 -0.56 -2.83A2.55 2.55 0 0 0 2.69 1.04Q3.12 0.70 2.96 1.22Z';
const ladder = Array.from({ length: 30 }, (_, i) => (i < 15 ? i + 1 : 14 - i) * 6)
  .map(deg => { const half = deg % 30 ? 2 : 5; return `M${-half} ${(-deg * GAUGE.pitch).toFixed(2)}h${half * 2}`; }).join('');
// Modifier keys as their key-cap symbols (Inter draws them); Option reads Alt off Apple keyboards.
const shift = '<kbd>⇧</kbd>', option = '<kbd class="hud-alt">⌥</kbd>';
// The controls panel: a column of paragraphs per action, keys first, then
// pointer and touch, whichever the device has. Keys come in paragraphs of key-and-effect rows
// (a cluster laid out as on the keyboard). Every sentence is one idea and leads
// with the action; a modifier comes last, "with ⇧". Mouse and trackpad share text.
const key = (code: string, label: string) => `<kbd data-key="${code}">${label}</kbd>`;
const cluster = (...keys: string[]) => `<span class="keys-t">${keys.join('')}</span>`;
const devices = ['pointer', 'touch'] as const;
type Group = { name: string; keys: [string, string][][]; faster?: string; how?: Partial<Record<(typeof devices)[number], string[]>> };
const groups: Group[] = [
  { name: 'Look', keys: [[[cluster(key('ArrowUp', '↑'), key('ArrowLeft', '←'), key('ArrowDown', '↓'), key('ArrowRight', '→')), '']], [[key('Backslash', '\\'), 'Horizon']]], faster: 'turn',
    how: { pointer: [`Drag with ${shift}, or middle-drag.`, 'Two-finger press and drag on a trackpad.', `Scroll on a trackpad with ${shift}.`, 'Right-drag with a mouse circles the point under the pointer.', 'Click the gauge for the horizon.'], touch: ['Two fingers together.', 'Tap the gauge for the horizon.'] } },
  { name: 'Fly', keys: [[[cluster(key('KeyW', 'W'), key('KeyA', 'A'), key('KeyS', 'S'), key('KeyD', 'D')), '']]], faster: 'fly',
    how: { pointer: ['Drag, or scroll on a trackpad.', 'Flick to coast.'], touch: ['Drag.', 'Flick to coast.'] } },
  { name: 'Roll', keys: [[[key('KeyQ', 'Q'), 'Left'], [key('KeyE', 'E'), 'Right'], [key('KeyH', 'H'), 'Level or flip']]], faster: 'roll',
    how: { pointer: [`Drag around the centre with ${option}<span data-only="gesture">, or rotate two fingers</span>.`], touch: ['Twist two fingers.'] } },
  { name: 'Altitude', keys: [[[key('KeyF', 'F'), 'Closer'], [key('KeyR', 'R'), 'Farther']]], faster: 'move',
    how: { pointer: ['Wheel or pinch.', 'Double-click a point to fly in.', `Double-click with ${shift} to back off.`], touch: ['Pinch, or double-tap and slide.', 'Double-tap to fly in.', 'Tap with two fingers to back off.'] } },
  { name: 'Zoom', keys: [[[key('Equal', '+'), 'In'], [key('Minus', '−'), 'Out'], [key('Digit0', '0'), 'Reset']]], faster: 'zoom',
    how: { pointer: [`Wheel or pinch with ${shift}.`] } },
  { name: 'Orbits', keys: [[[key('Digit1', '1'), 'Free flight'], [key('Digit2', '2'), 'ISS'], [key('Digit3', '3'), 'Polar'], [key('Digit4', '4'), 'High']]] },
  { name: 'Time', keys: [[[key('Space', 'Space'), 'Pause or play']]] },
];
---
<div class="flight-hud" data-modality="mouse">
  <div class="hud-time" role="group" aria-label="Time">
    <button class="explorer-motion hud-time-toggle" type="button" aria-label="Pause" title="Pause"><svg class="motion-play" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" data-hidden><path d="m5 3 8 5-8 5z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg><svg class="motion-pause" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
    <time class="explorer-time"><span class="explorer-date">—</span><span class="explorer-clock">—</span></time>
    <span class="hud-time-scale" data-time-scale title="Time scale; change it in Settings">10×</span>
    <span class="time-hint" aria-hidden="true"><button type="button" class="time-key" data-press="Space" tabindex="-1" title="Stop or start time (Space)"><kbd data-key="Space">Space</kbd></button><span>Time</span></span>
    <div class="hud-clock">
      <div id="explorer-speed" class="hud-tape hud-htape" style="--span: clamp(140px, 13cqw, 160px)" role="slider" tabindex="0" aria-label="Time scale" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax={SPEED_MAX} aria-valuenow="10">
        <div class="hud-scale" aria-hidden="true">
          {speedTicks.map(at => <span class="hud-tick" style={`left:${(at * 100).toFixed(3)}%`}></span>)}
          {speedMarks.map(speed => <span class="hud-tick major" data-at={speedFraction(speed)} style={`left:${(speedFraction(speed) * 100).toFixed(3)}%`}><b>{speed}×</b></span>)}
        </div>
        <div class="hud-now" aria-hidden="true"><output data-time-scale>10×</output></div>
      </div>
      <div id="explorer-day" class="hud-tape hud-htape" style="--span: clamp(150px, 16cqw, 210px)" role="slider" tabindex="0" aria-label="Date" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="365" aria-valuenow="0">
        <div class="hud-scale" aria-hidden="true">
          {dayTicks.map(day => <span class="hud-tick" style={`left:${(day / 365 * 100).toFixed(3)}%`}></span>)}
          {monthStarts.map(day => <span class="hud-tick major" data-at={months[day] && day < 365 ? day / 365 : undefined} style={`left:${(day / 365 * 100).toFixed(3)}%`}>{months[day] && <b>{months[day]}</b>}</span>)}
        </div>
        <div class="hud-now" aria-hidden="true"><output>—</output></div>
      </div>
      <div id="explorer-minute" class="hud-tape hud-htape" style="--span: clamp(190px, 23cqw, 288px)" role="slider" tabindex="0" aria-label="Time of day in UTC" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="1439" aria-valuenow="0">
        <div class="hud-scale" aria-hidden="true">
          {halfHours.filter(minute => minute % 180).map(minute => <span class="hud-tick" style={`left:${(minute / 1440 * 100).toFixed(3)}%`}></span>)}
          {halfHours.filter(minute => !(minute % 180)).map(minute => <span class="hud-tick major" data-at={minute / 1440} style={`left:${(minute / 1440 * 100).toFixed(3)}%`}><b>{String(minute / 60).padStart(2, '0')}</b></span>)}
        </div>
        <div class="hud-now" aria-hidden="true"><output>—</output></div>
      </div>
    </div>
  </div>

  <div class="hud-altimeter hud-meter" style={`--longest: ${Math.max(...scale.map(({ km }) => label(km).length))}`}>
    <nav class="hud-modes hud-list" aria-label="Camera">
      <button type="button" data-flight-mode="free" aria-pressed="false" title="Fly from here"><kbd data-key="Digit1">1</kbd>Free</button>
      <button type="button" data-orbit="iss" aria-pressed="true"><kbd data-key="Digit2">2</kbd>ISS</button>
      <button type="button" data-orbit="polar" aria-pressed="false"><kbd data-key="Digit3">3</kbd>Polar</button>
      <button type="button" data-orbit="high" aria-pressed="false"><kbd data-key="Digit4">4</kbd>High</button>
    </nav>
    <div id="explorer-altitude" class="hud-tape" role="slider" tabindex="0" aria-label="Altitude" aria-orientation="vertical" aria-valuemin={MIN_ALTITUDE} aria-valuemax={MAX_ALTITUDE} aria-valuenow="420" aria-valuetext="420 km">
      <div class="hud-scale" aria-hidden="true">
        {short.map(top => <span class="hud-tick" style={`top:${top.toFixed(3)}%`}></span>)}
        {scale.map(({ km }) => <span class="hud-tick major" style={`top:${position(km).toFixed(3)}%`}><b data-crowded={[200, 3000, 30000].includes(km) ? '' : undefined}>{label(km)}</b></span>)}
      </div>
      <div class="hud-now" aria-hidden="true"><output class="altitude-output">420 km</output></div>
    </div>
    <button type="button" class="hud-key" data-hold="KeyR" tabindex="-1" title="Farther (R)"><kbd data-key="KeyR">R</kbd><span>Farther</span></button>
    <button type="button" class="hud-key" data-hold="KeyF" tabindex="-1" title="Closer (F)"><kbd data-key="KeyF">F</kbd><span>Closer</span></button>
  </div>

  <div class="hud-left">
    <div class="hud-ev hud-meter" style={`--longest: ${Math.max(...evStops.map(ev => evLabel(ev).length))}`}>
      <div id="explorer-ev" class="hud-tape" role="slider" tabindex="0" aria-label="Exposure compensation" aria-orientation="vertical" aria-valuemin={EV_MIN} aria-valuemax={EV_MAX} aria-valuenow="0" aria-valuetext="0.0 EV">
        <div class="hud-scale" aria-hidden="true">
          {evThirds.map(ev => <span class="hud-tick" style={`top:${evPosition(ev).toFixed(3)}%`}></span>)}
          {evStops.map(ev => <span class="hud-tick major" data-mark={ev} style={`top:${evPosition(ev).toFixed(3)}%`}><b>{evLabel(ev)}</b></span>)}
        </div>
        <div class="hud-now" aria-hidden="true"><output class="ev-output">0.0 EV</output></div>
      </div>
    </div>
    <div class="hud-zoom hud-meter" style={`--longest: ${Math.max(...lensScale.map(({ zoom }) => `${zoom}×`.length))}`}>
      <div id="explorer-lens" class="hud-tape" role="slider" tabindex="0" aria-label="Lens" aria-orientation="vertical" aria-valuemin={LENS_MIN} aria-valuemax={LENS_MAX} aria-valuenow="1" aria-valuetext="1×, 30 mm">
        <div class="hud-scale" aria-hidden="true">
          {lensShort.map(top => <span class="hud-tick" style={`top:${top.toFixed(3)}%`}></span>)}
          {lensScale.map(({ zoom }) => <span class="hud-tick major" data-mark={zoom} style={`top:${lensPosition(zoom).toFixed(3)}%`}><b>{zoom}×</b></span>)}
        </div>
        <div class="hud-now" aria-hidden="true"><output class="lens-output">1×</output></div>
      </div>
      <button type="button" class="hud-key" data-hold="Equal" tabindex="-1" title="Zoom in (+)"><kbd data-key="Equal">+</kbd><span>Zoom in</span></button>
      <button type="button" class="hud-key" data-hold="Minus" tabindex="-1" title="Zoom out (−)"><kbd data-key="Minus">−</kbd><span>Zoom out</span></button>
      <button type="button" class="hud-key" data-press="Digit0" tabindex="-1" title="Reset zoom (0)"><kbd data-key="Digit0">0</kbd><span>Reset zoom</span></button>
    </div>
  </div>

  <div class="hud-dock">
    <div class="hud-attitude">
      <button type="button" class="hud-roll" data-hold="KeyQ" tabindex="-1" aria-label="Roll left" title="Roll left (Q)"><kbd data-key="KeyQ">Q</kbd><svg class="hud-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12A8 8 0 1 0 6.34 6.34" /><path d="M10.34 6.34H6.34V2.34" /></svg></button>
      <div class="hud-gauge">
      <svg class="gauge" viewBox="-24 -24 48 48" width="64" height="64">
        <defs><mask id="hud-gauge-mask" maskUnits="userSpaceOnUse" x="-24" y="-24" width="48" height="48">
          <circle r={GAUGE.dial} fill="#fff" />
          <g class="gauge-horizon"><line class="gauge-cut" x1="-48" x2="48" y1="0" y2="0" /><path class="gauge-cut" d={ladder} /></g>
          <path class="gauge-sun-cut" d={sunStar} style={`transform: translate(0px, ${-GAUGE.sunAt}px)`} />
          <path class="gauge-moon-cut" d={crescent} style={`transform: translate(0px, ${-GAUGE.moonAt}px)`} />
        </mask>
        <mask id="hud-gauge-cut-mask" maskUnits="userSpaceOnUse" x="-40" y="-40" width="80" height="80">
          <rect x="-40" y="-40" width="80" height="80" fill="#fff" />
          <path class="gauge-sun-cut" d={sunStar} style={`transform: translate(0px, ${-GAUGE.sunAt}px)`} />
          <path class="gauge-moon-cut" d={crescent} style={`transform: translate(0px, ${-GAUGE.moonAt}px)`} />
        </mask></defs>
        <g class="gauge-dial" role="button" tabindex="0" aria-label="Look at the horizon"><title>Horizon (\)</title>
          <circle class="gauge-hit" r={GAUGE.dial} />
          <g class="gauge-fill" mask="url(#hud-gauge-mask)"><g class="gauge-horizon">
            <rect class="gauge-sky" x="-48" y="-96" width="96" height="96" />
            <rect class="gauge-ground" x="-48" y="0" width="96" height="96" />
          </g></g>
          <path class="gauge-wings" mask="url(#hud-gauge-cut-mask)" d="M-13 0h9l2 2.5l2 -2.5l2 2.5l2 -2.5h9" />
        </g>
        <g class="gauge-earth" role="button" tabindex="0" aria-label="Face Earth" mask="url(#hud-gauge-cut-mask)"><title>Face Earth</title>
          <path class="gauge-hit" d="" /><path class="gauge-stroke" d="" />
        </g>
        <g class="gauge-sun" role="button" tabindex="0" aria-label="Face the Sun" style={`transform: translate(0px, ${-GAUGE.sunAt}px)`}><title>Face the Sun</title>
          <circle class="gauge-hit" r={GAUGE.sun + 2.5} /><path class="gauge-stroke" d={sunStar} />
        </g>
        <g class="gauge-moon" role="button" tabindex="0" aria-label="Face the Moon" style={`transform: translate(0px, ${-GAUGE.moonAt}px)`}><title>Face the Moon</title>
          <circle class="gauge-hit" r={GAUGE.moon + 2.5} /><path class="gauge-stroke" d={crescent} />
        </g>
      </svg>
      </div>
      <button type="button" class="hud-roll" data-hold="KeyE" tabindex="-1" aria-label="Roll right" title="Roll right (E)"><kbd data-key="KeyE">E</kbd><svg class="hud-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12A8 8 0 1 1 17.66 6.34" /><path d="M13.66 6.34H17.66V2.34" /></svg></button>
    </div>
  </div>

  <div class="hud-pad hud-fly" role="group" aria-label="Fly">
    <button type="button" class="hud-key" data-hold="KeyW" tabindex="-1" aria-label="Forward" title="Forward (W)"><kbd data-key="KeyW">W</kbd></button>
    <button type="button" class="hud-key" data-hold="KeyA" tabindex="-1" aria-label="Left" title="Left (A)"><kbd data-key="KeyA">A</kbd></button>
    <span class="hud-globe" aria-hidden="true"><canvas width="18" height="18"></canvas><svg viewBox="-9 -9 18 18" width="18" height="18"><circle class="globe-outline" r="8.5" /></svg></span>
    <button type="button" class="hud-key" data-hold="KeyD" tabindex="-1" aria-label="Right" title="Right (D)"><kbd data-key="KeyD">D</kbd></button>
    <button type="button" class="hud-key" data-hold="KeyS" tabindex="-1" aria-label="Back" title="Back (S)"><kbd data-key="KeyS">S</kbd></button>
  </div>

    <div class="hud-pad hud-look" role="group" aria-label="Look">
      <button type="button" class="hud-key" data-hold="ArrowUp" tabindex="-1" aria-label="Look up" title="Look up (↑)"><kbd data-key="ArrowUp">↑</kbd></button>
      <button type="button" class="hud-key" data-hold="ArrowLeft" tabindex="-1" aria-label="Look left" title="Look left (←)"><kbd data-key="ArrowLeft">←</kbd></button>
      <button type="button" class="hud-key" data-press="Backslash" tabindex="-1" aria-label="Horizon" title="Horizon (\)"><kbd data-key="Backslash">\</kbd></button>
      <button type="button" class="hud-key" data-hold="ArrowRight" tabindex="-1" aria-label="Look right" title="Look right (→)"><kbd data-key="ArrowRight">→</kbd></button>
      <button type="button" class="hud-key" data-hold="ArrowDown" tabindex="-1" aria-label="Look down" title="Look down (↓)"><kbd data-key="ArrowDown">↓</kbd></button>
    </div>

  <div class="explorer-controls hud-corner hud-list" hidden>
    <button class="hud-info" type="button" popovertarget="explorer-info" title="Info (i)"><kbd data-key="KeyI">i</kbd>Info</button>
    <button type="button" popovertarget="flight-help" title="Help (? or F1)"><kbd data-key="Slash">?</kbd>Help</button>
    <button class="explorer-settings-toggle" type="button" popovertarget="explorer-settings" title="Settings" aria-label="Settings"><span class="hud-cap"><svg class="hud-gear" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.7 2-.5 2.2-1.8 1-2.2-.7-2.3 4 1.7 1.5v2l-1.7 1.5 2.3 4 2.2-.7 1.8 1 .5 2.2h4.6l.5-2.2 1.8-1 2.2.7 2.3-4-1.7-1.5v-2l1.7-1.5-2.3-4-2.2.7-1.8-1-.5-2.2z" transform="translate(0 1)" /><circle cx="12" cy="12" r="3" /></svg></span></button>
  </div>

  <span class="hud-pulse" aria-hidden="true" hidden></span>
  <div class="hud-pin" aria-hidden="true" hidden><svg><path class="pin-spot" d="" /><g class="pin-ripples"><path d="" /><path d="" /><path d="" /></g><path class="pin-ring pin-halo" d="" /><path class="pin-ring" d="" /><line class="pin-stalk pin-halo" /><line class="pin-stalk" /><circle class="pin-head" r="2.5" /></svg></div>
  <div class="hud-fpm" aria-hidden="true" hidden><svg viewBox="-18 -12 36 24" width="36" height="24"><g class="fpm-halo"><circle r="5" /><path d="M-16 0h11M5 0h11M0 -5v-6" /></g><circle r="5" /><path d="M-16 0h11M5 0h11M0 -5v-6" /></svg><span class="hud-speed"></span></div>
</div>

<div id="flight-help" class="flight-help" popover="manual" role="region" aria-label="Controls" data-modality="mouse">
  <button class="help-close" type="button" popovertarget="flight-help" popovertargetaction="hide" aria-label="Close controls" title="Close (? or F1)"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
  <div class="help-grid">
    {groups.map((group, column) => <section class="help-col">
      <div class="help-head" data-column={column}><h2>{group.name}</h2></div>
      <div class="help-cell" data-lane="keys" data-column={column}>
        {group.keys.map(paragraph => <div class="help-par">{paragraph.map(([keys, effect]) => <div class="help-bind"><span class="help-k" set:html={keys} />{effect && <span class="help-a">{effect}</span>}</div>)}</div>)}
        {group.faster && <p class="help-hold" set:html={`Hold ${key('ShiftLeft', '⇧')} to ${group.faster} faster.`} />}
      </div>
      {devices.map(device => group.how?.[device] && <div class="help-cell" data-lane={device} data-column={column}>{group.how[device]!.map(line => <p set:html={line} />)}</div>)}
    </section>)}
  </div>
</div>

<div id="explorer-info" class="explorer-info explorer-dialog" popover="auto" role="dialog" aria-labelledby="explorer-info-heading">
  <header class="dialog-header"><h2 id="explorer-info-heading">Info</h2>
    <button class="dialog-close" type="button" popovertarget="explorer-info" popovertargetaction="hide" aria-label="Close info"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></button></header>
  <p class="help-lede">Earth, its atmosphere and the night sky, rendered in real time from a replayed ISS orbit, two model orbits or free flight. Lighting follows the date and time you pick; clouds and terrain come from satellite maps, not live weather.</p>
  <section class="info-credits" aria-labelledby="info-credits-heading">
    <h3 id="info-credits-heading">Image credits</h3>
    <SceneCredits />
  </section>
</div>

<style>
  /* The HUD box ends above the docked controls panel; contain: layout makes it
     the containing block of its fixed parts, so they all move up with it, and as
     a size container its height (cqh) sizes the tape instead of the screen's. */
  .flight-hud { --hud-glass: rgb(8 10 14 / 62%); --hud-dim: rgb(255 255 255 / 58%); --hud-accent: #d3a784; --hud-mono: 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace; --hud-top: max(12px, env(safe-area-inset-top)); --hud-left: max(12px, env(safe-area-inset-left)); --hud-right: max(12px, env(safe-area-inset-right)); --hud-bottom: max(12px, env(safe-area-inset-bottom)); position: fixed; inset: 0 0 var(--explorer-inset-bottom, 0px); contain: layout; container-type: size; z-index: 4; pointer-events: none; color: #fff; font: 11px/1.35 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; transition: opacity .5s ease; }
  :global(earthlight-explorer:not([data-ready])) .flight-hud { opacity: 0; }
  .hud-time, .hud-list, .hud-attitude, .hud-meter, .hud-pad { pointer-events: auto; }
  .flight-hud { user-select: none; -webkit-user-select: none; }
  /* Hint text arrives as HTML, so its keys are styled globally within the HUD. */
  /* Key caps and the controls panel use a subset of Inter (public/fonts, OFL): its arrows and ⇧ ⌥ suit keys. */
  @font-face { font-family: 'Inter Subset'; src: url('/fonts/inter-subset.woff2') format('woff2'); font-weight: 400 700; font-display: swap; }
  /* Keys: inner corners all 3 px; the 2 px bottom edge gets a taller outer curve to match. */
  /* Single-glyph keys are square, 18 px either way; the widest, ⇧ and W, fit with their padding. */
  .flight-hud :global(kbd), .flight-help :global(kbd) { display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 3px; box-sizing: border-box; border: 1px solid rgb(255 255 255 / 30%); border-bottom-width: 2px; border-radius: 4px 4px 4px 4px / 4px 4px 5px 5px; color: #fff; font: 500 10px/1 'Inter Subset', -apple-system, BlinkMacSystemFont, sans-serif; text-transform: none; letter-spacing: 0; vertical-align: baseline; transition: background-color .08s, color .08s, transform .08s, border-color .08s; }
  /* ⌫ is wider than the rest; without padding it stays square too. */
  .flight-hud :global(kbd[data-key="Backspace"]), .flight-help :global(kbd[data-key="Backspace"]) { padding: 0; }
  /* A key that is a button takes a faint fill under the pointer. */
  .flight-hud button:not([aria-pressed="true"]):hover :global(kbd:not([data-pressed])) { background: rgb(255 255 255 / 16%); }
  /* A held key, and the active camera preset, look pressed. */
  .flight-hud :global(kbd[data-pressed]), .hud-list [aria-pressed="true"] kbd { background: #fff; border-color: #fff; color: #000; transform: translateY(1px); }
  /* Without a keyboard, key caps mean nothing. */
  .flight-hud:not([data-keyboard]) :is(.hud-key, .hud-pad), .flight-hud:not([data-keyboard]) .time-hint, .flight-hud:not([data-keyboard]) :is(.hud-list, .hud-roll) kbd { display: none; }
  /* Plain translucent fills; a backdrop blur over the live canvas costs frames and leaves artefacts. */
  button { font: inherit; color: inherit; cursor: pointer; }
  /* Focus shows as a fill, never a frame. */
  :is(button, [role="slider"]):focus-visible { outline: none; }

  /* Replay clock: Space or the button pauses it. */
  .hud-time { position: fixed; top: var(--hud-top); left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 14px; height: 24px; padding: 0; box-sizing: border-box; font: 500 10px/1 var(--hud-mono); color: #fff; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* Play and pause sit in a key cap's frame, like the Settings gear, and never shrink. */
  .hud-time-toggle { flex: none; padding: 0; background: none; color: #fff; }
  .explorer-time { display: flex; gap: 14px; }
  .hud-time-toggle svg[data-hidden] { display: none; }
  /* Never squeezed: the cap keeps its word inside its frame at any width. */
  .time-hint { flex: none; display: flex; align-items: center; gap: 5px; color: var(--hud-dim); font-weight: 500; white-space: nowrap; }
  /* Key caps on the screen are buttons too: hold R, F, Z or X as you would the
     key; Space pauses. The button is the cap alone, so they look as before; a
     cap lights while held, as for the real key. */
  .hud-key, .time-key { display: grid; padding: 0; border: 0; background: none; touch-action: none; }
  /* Wide enough, the clock becomes three tapes along the top, plain like the
     side ones: time scale, date and time of day (UTC), after only Space and its
     name; 0× is stopped, so no play button. Ticks hang from the edge, labels
     sit under them and the reading under the labels, joined by a rule; press or
     drag along a tape, scroll over it, or use the arrow keys. Only the Settings
     gear shares the top edge, so the tapes fit from 820 px; narrower, the
     one-line clock stays. */
  /* The gap clears the end labels, which stand half out of their tapes. */
  .hud-clock { display: none; align-items: flex-start; gap: 48px; }
  @container (min-width: 820px) {
    /* As wide as its tapes: centred from the middle, it would otherwise squeeze them. */
    .hud-time { width: max-content; align-items: flex-start; gap: 24px; height: auto; padding: 0; background: none; }
    .hud-time :is(.explorer-time, .hud-time-scale, .hud-time-toggle) { display: none; }
    /* Space sits at the top; the tapes hang 6 px lower, so their short ticks
       share an axis with its name. */
    .time-hint { align-self: flex-start; }
    .hud-clock { display: flex; margin-top: 6px; }
  }
  .hud-tape.hud-htape { --tick-end: 0px; --reach: 32px; width: var(--span); height: 30px; cursor: ew-resize; }
  .hud-htape .hud-tick { top: var(--tick-end); right: auto; width: 1px; height: 6px; }
  .hud-htape .hud-tick.major { width: 1px; height: 12px; }
  .hud-htape .hud-tick b { top: 15px; right: auto; left: 0; transform: translateX(-50%); }
  .hud-htape .hud-now { top: 0; bottom: auto; left: var(--at); right: auto; width: 0; height: 0; }
  .hud-htape .hud-now::before { top: var(--tick-end); right: auto; left: 0; width: 1px; height: calc(var(--reach) - var(--tick-end)); }
  .hud-htape .hud-now output { top: var(--reach); right: auto; left: 0; transform: translateX(-50%); }

  /* Camera presets and free flight, top right above the altitude tape: no plate,
     keys flush with the screen edge like R and F, names to their left. */
  .hud-list { display: grid; justify-items: end; }
  /* The presets head the altitude tape: keys flush with the edge, names to their left. */
  .hud-modes { justify-self: end; }
  /* Settings alone top right, a gear in a key cap's frame; Info, then Help, in the lower-right corner. */
  .hud-corner .explorer-settings-toggle { position: fixed; top: var(--hud-top); right: var(--hud-right); padding: 0; }
  .hud-cap, .hud-time-toggle { display: grid; place-items: center; width: 24px; height: 24px; box-sizing: border-box; border: 1px solid rgb(255 255 255 / 30%); border-bottom-width: 2px; border-radius: 5px 5px 5px 5px / 5px 5px 6px 6px; transition: background-color .08s; }
  :is(.explorer-settings-toggle:is(:hover, :focus-visible) .hud-cap, .hud-time-toggle:is(:hover, :focus-visible)) { background: rgb(255 255 255 / 16%); }
  /* Info alone in the lower-left corner, mirrored: key at the edge, name inside. */
  .hud-corner .hud-info { position: fixed; left: var(--hud-left); bottom: var(--hud-bottom); flex-direction: row; padding: 0 12px 0 0; }
  /* Settings, help and info in the lower-right corner, set like the presets; settings has no key, so a gear. */
  .hud-corner { position: fixed; right: var(--hud-right); bottom: var(--hud-bottom); }
  .hud-corner[hidden] { display: none; }
  /* White like the key caps beside it, whatever the label does. */
  .hud-gear { flex: 0 0 16px; color: #fff; }
  .hud-list button { display: flex; flex-direction: row-reverse; align-items: center; gap: 8px; height: 24px; padding: 0 0 0 12px; border: 0; background: none; color: var(--hud-dim); font: 600 10px/1 var(--hud-mono); letter-spacing: .06em; text-transform: uppercase; }
  /* Not a segmented control: no fills; the active preset's key looks pressed and its name turns white. */
  .hud-list button:is(:hover, :focus-visible, [aria-pressed="true"]) { color: #fff; }
  /* A held roll key lights its name too. */
  .hud-list button:has(kbd[data-pressed]) { color: #fff; }

  /* The horizon gauge sits at the bottom centre, between its roll buttons and the look keys. */
  /* --hud-dock-lift keeps it clear of the controls panel's tab (flight-hud.ts). */
  .hud-dock { position: fixed; left: var(--hud-left); right: var(--hud-right); bottom: calc(var(--hud-bottom) + var(--hud-dock-lift, 0px)); display: flex; justify-content: center; align-items: flex-end; gap: 8px; pointer-events: none; }


  /* Horizon gauge; click for the horizon. Outside the dial, 3 px off
     it, an arc points to Earth and a ring to the Sun. */
  /* One row at the bottom centre: Roll left, the dial, Roll right, each key
     against the dial and its icon outside. The gaps leave room for the Sun ring
     outside the dial. */
  .hud-attitude { display: flex; align-items: center; gap: 16px; color: #fff; pointer-events: auto; }
  /* Turning arrows instead of names, the gear's size, Q's anticlockwise on the
     left and E's clockwise on the right. They read as the names did: dim, white
     under the pointer or while held. */
  .hud-roll { display: flex; align-items: center; gap: 8px; height: 24px; padding: 0; border: 0; background: none; color: var(--hud-dim); touch-action: none; }
  .hud-roll:is(:hover, :has(kbd[data-pressed])) { color: #fff; }
  .hud-roll[data-hold="KeyQ"] { flex-direction: row-reverse; }
  /* Down on the row's bottom edge, level with the crosses' bottom keys. */
  .hud-roll { align-self: flex-end; }
  .hud-icon { flex: 0 0 16px; }
  /* WASD and the arrows as crosses along the bottom, at a quarter and three
     quarters of the width, rows on the presets' 24 px pitch and keys in a row
     the same 6 px apart as the rows. W and ↑ on top; a globe, set like the roll
     icons, marks the middle of WASD, which flies over it; \ (reset the camera)
     sits in the arrows'. */
  .hud-pad { position: fixed; bottom: var(--hud-bottom); display: grid; grid-template-columns: repeat(3, auto); grid-template-rows: repeat(3, 24px); align-items: center; column-gap: 6px; transform: translateX(-50%); }
  .hud-fly { left: 25%; }
  .hud-look { left: 75%; }
  .hud-pad > :is([data-hold="KeyW"], [data-hold="ArrowUp"]) { grid-area: 1 / 2; }
  .hud-pad > :is([data-hold="KeyA"], [data-hold="ArrowLeft"]) { grid-area: 2 / 1; }
  .hud-pad > :is([data-press="Backslash"], .hud-globe) { grid-area: 2 / 2; }
  /* A small Earth the size of a key, as seen from straight above the camera with
     north up: land filled the colour of the tapes' ticks, sea left clear, and
     only the near hemisphere, so it reads as solid. It turns as you fly and as
     Earth turns under the orbit (flight-hud.ts paints it). */
  .hud-globe { position: relative; justify-self: center; width: 18px; height: 18px; line-height: 0; }
  .hud-globe :is(canvas, svg) { position: absolute; inset: 0; width: 18px; height: 18px; overflow: visible; }
  .globe-outline { fill: none; stroke: var(--hud-dim); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .hud-pad > :is([data-hold="KeyD"], [data-hold="ArrowRight"]) { grid-area: 2 / 3; }
  .hud-pad > :is([data-hold="KeyS"], [data-hold="ArrowDown"]) { grid-area: 3 / 2; }
  /* Heading, pitch and roll, then latitude and longitude below, in the lower-left corner. */
  /* Only the drawn parts take the pointer: the masked sky and ground are far larger than the dial. */
  .hud-gauge { line-height: 0; pointer-events: none; }
  .gauge { pointer-events: none; }
  .gauge { overflow: visible; }
  /* The dial has no outline: a pale grey sky and an orange ground, parted by a
     1 px gap at the horizon. The pitch ladder is cut out of them the same way. */
  .gauge-horizon { transform: rotate(var(--roll, 0deg)) translateY(var(--pitch, 0px)); transition: transform .06s linear; }
  /* Monochrome like the rest of the HUD: the ground is white as bright as the
     accent it used to be, the sky fainter. */
  .gauge-sky { fill: rgb(255 255 255 / 26%); }
  .gauge-ground { fill: rgb(255 255 255 / 68%); }
  /* Sky and ground stay faint until the pointer or focus is on the gauge. */
  .gauge-fill { opacity: .45; }
  /* Each part answers the pointer alone: the dial brightens its own fill. */
  .gauge-dial:is(:hover, :focus-visible) .gauge-fill { opacity: 1; }
  .gauge-cut { fill: none; stroke: #000; stroke-width: 1px; vector-effect: non-scaling-stroke; }
  /* Earth arc, Sun ring and wings: 1 px whatever the dial's size. The arc and
     ring match the tapes' ticks, half-white, until the gauge is hovered. */
  .gauge-stroke, .gauge-wings { fill: none; stroke: #fff; stroke-width: 1px; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  .gauge-stroke { stroke: rgb(255 255 255 / 50%); }
  /* Three targets, each only where it is drawn: the dial levels or flips, the
     Earth arc turns the camera to Earth and the Sun ring to the Sun. A thin
     stroke takes a wider invisible one for the pointer, and thickens to 2 px
     under it. */
  .gauge-hit { fill: none; stroke: none; cursor: pointer; }
  .gauge-dial .gauge-hit, :is(.gauge-sun, .gauge-moon) .gauge-hit { pointer-events: fill; }
  .gauge-earth .gauge-hit { stroke: transparent; stroke-width: 10px; vector-effect: non-scaling-stroke; pointer-events: stroke; }
  /* Under the pointer the arc turns white and 2 px; the Sun and Moon fill in. */
  .gauge-earth:is(:hover, :focus-visible) .gauge-stroke { stroke: #fff; stroke-width: 2px; }
  :is(.gauge-sun, .gauge-moon):is(:hover, :focus-visible) .gauge-stroke { stroke: #fff; fill: #fff; }
  .gauge [role="button"]:focus { outline: none; }
  /* The Sun flies outside the Earth arc and the Moon along it; each cuts its
     own shape, and a clear gap round it, out of all it crosses: the dial's fill
     and ladder, the Earth arc and the wings. */
  .gauge-sun, .gauge-sun-cut, .gauge-moon, .gauge-moon-cut { transition: transform .25s ease-out; }
  /* The cut is the icon's own shape, so its inside is a hole onto the scene
     rather than a dark disc, and a 3 px stroke leaves 1 px clear round the
     outline drawn over it. */
  :is(.gauge-sun-cut, .gauge-moon-cut) { fill: #000; stroke: #000; stroke-width: 3px; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  :is(.gauge-sun, .gauge-sun-cut, .gauge-moon, .gauge-moon-cut)[hidden] { display: none; }

  /* Two logarithmic tapes, mid-height at either edge: altitude on the right, with
     R and F, and its mirror, the lens, on the left, with Z and X. Drag one, scroll
     over it, or use its keys. Marks sit inside the axis; the reading is plain text
     beyond them. */
  /* --tick-end sets the ticks in from the edge that the keys share. */
  /* --tape is the altitude tape's height; the lens tape takes a share of it. */
  /* --reach puts the reading just past the longest label (--longest characters
     of the 9 px monospace, 0.6 em each), with the same gap on both tapes. */
  .hud-meter { --axis: 112px; --tick-end: 3px; --reach: calc(var(--tick-end) + 17px + var(--longest, 3) * 5.4px + 6px); --tape: clamp(180px, calc(46cqh - 70px), 360px); position: fixed; top: 50%; transform: translateY(-50%); display: grid; gap: 20px; }
  .hud-altimeter { right: var(--hud-right); }
  /* The left column: exposure compensation over the lens tape, centred together. */
  .hud-left { position: fixed; left: var(--hud-left); top: 50%; transform: translateY(-50%); display: grid; gap: 44px; justify-items: start; }
  .hud-left > .hud-meter { position: static; transform: none; }
  /* Shorter tapes on the left keep their ticks about as close as the altitude
     tape's: the lens 32 gaps to 46, exposure 21 thirds of a stop. */
  .hud-zoom { --tape-share: .7; }
  .hud-ev { --tape-share: .45; }
  /* Manual exposure has no compensation. */
  .hud-ev[hidden] { display: none; }
  /* Keys end flush with the axis and carry their names, set like the presets:
     the name on the inner side of the cap. Backspace, back to 1×, sits under −
     on the presets' 24 px pitch. */
  .hud-meter .hud-key { display: flex; align-items: center; gap: 8px; color: var(--hud-dim); font: 600 10px/1 var(--hud-mono); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .hud-meter .hud-key:is(:hover, :has(kbd[data-pressed])) { color: #fff; }
  .hud-altimeter .hud-key { flex-direction: row-reverse; justify-self: end; }
  .hud-zoom .hud-key { justify-self: start; }
  /* Keys under their tape, 20 px off it and on the presets' 24 px pitch. */
  .hud-meter .hud-key + .hud-key { margin-top: -14px; }
  .hud-tape { --at: 82%; position: relative; width: calc(var(--axis) + 1px); height: calc(var(--tape) * var(--tape-share, 1)); cursor: ns-resize; touch-action: none; }
  /* No axis line: the ticks' right ends draw it. */
  .hud-scale { position: absolute; inset: 0; z-index: 1; }
  /* Short and long ticks differ only in length. */
  .hud-tick { position: absolute; right: var(--tick-end); width: 6px; height: 1px; background: rgb(255 255 255 / 50%); }
  .hud-tick.major { width: 12px; }
  .hud-tick b { position: absolute; right: 17px; top: -6px; color: rgb(255 255 255 / 66%); font: 500 9px/12px var(--hud-mono); white-space: nowrap; }
  .hud-tick b, .hud-now output { text-shadow: 0 0 3px rgb(0 0 0 / 85%), 0 0 1px rgb(0 0 0 / 90%); }
  /* The reading: plain text beyond the labels, joined to the axis by a rule that
     passes under them. Hover or focus fills it opaque orange. */
  .hud-now { position: absolute; left: 0; right: 0; top: var(--at); height: 0; color: #fff; }
  .hud-now::before { content: ''; position: absolute; right: var(--tick-end); top: 0; width: calc(var(--reach) - var(--tick-end)); height: 1px; background: currentColor; }
  .hud-now output { position: absolute; right: var(--reach); top: -9px; padding: 2px 6px; border-radius: 4px; color: inherit; font: 700 10px/14px var(--hud-mono); letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hud-tape:is(:hover, :focus-visible) .hud-now { color: var(--hud-accent); }
  .hud-tape:is(:hover, :focus-visible) .hud-now output { background: var(--hud-accent); color: #000; text-shadow: none; }
  /* The left tapes, mirrored. */
  .hud-left .hud-tick { right: auto; left: var(--tick-end); }
  .hud-left .hud-tick b { right: auto; left: 17px; }
  .hud-left .hud-now::before { right: auto; left: var(--tick-end); }
  .hud-left .hud-now output { right: auto; left: var(--reach); }

  .hud-fpm { position: fixed; left: 0; top: 0; display: flex; align-items: center; gap: 4px; color: var(--hud-accent); pointer-events: none; transform: translate(calc(var(--x, -100px) - 18px), calc(var(--y, -100px) - 12px)); }
  .hud-fpm[hidden] { display: none; }
  .hud-fpm svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
  /* A dark halo drawn under the marker instead of a per-frame filter. */
  .hud-fpm .fpm-halo { stroke: rgb(0 0 0 / 55%); stroke-width: 3.5; }
  .hud-speed { text-shadow: 0 0 3px rgb(0 0 0 / 80%); font: 600 9px/1 var(--hud-mono); letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* The ground pin: where a right-drag circles and where a double-click flies.
     A lit spot and a ring lie on the ground round the point, a stalk stands up
     from it, and ripples spread over the ground as it lands, all in perspective
     so they tilt with the land (flight-hud.ts draws it). */
  .hud-pin { position: fixed; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; color: var(--hud-accent); }
  .hud-pin svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .hud-pin[hidden] { display: none; }
  .hud-pin :is(path, line) { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .hud-pin .pin-halo { stroke: rgb(0 0 0 / 55%); stroke-width: 3.5; }
  .hud-pin .pin-spot { fill: rgb(211 167 132 / 24%); stroke: none; }
  .pin-head { fill: currentColor; stroke: rgb(0 0 0 / 55%); stroke-width: 1; }
  .hud-pulse[hidden] { display: none; }
  .hud-pulse { position: fixed; width: 56px; height: 56px; margin: -28px 0 0 -28px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--hud-accent); pointer-events: none; animation: hud-pulse .7s ease-out forwards; }
  @keyframes hud-pulse { from { transform: scale(.2); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }

  /* Phones: compact instruments. */
  @media (max-width: 640px) {
    .hud-time { gap: 10px; }
    .explorer-time { gap: 10px; }
    .gauge { width: 50px; height: 50px; }
    .hud-attitude { gap: 12px; }
    /* Centred in the room the corner buttons leave. */
    .hud-dock { left: calc(var(--hud-left) + 64px); right: calc(var(--hud-right) + 64px); }
    .hud-meter { --tape: clamp(150px, 26cqh, 240px); }
  }
  /* The clock row shares the top edge with the gear until it would reach it:
     with Space and its name below 420 px, without them below 330 px. */
  @container (max-width: 420px) { .flight-hud[data-keyboard] .hud-corner .explorer-settings-toggle { top: calc(var(--hud-top) + 36px); } }
  @container (max-width: 330px) { .hud-corner .explorer-settings-toggle { top: calc(var(--hud-top) + 36px); } }
