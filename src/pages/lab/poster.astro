---
const assetBase=import.meta.env.PUBLIC_EARTHLIGHT_ASSET_BASE_URL || '/media/earthlight/';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>Poster capture</title></head>
<body data-asset-base={assetBase}><canvas aria-label="Background poster capture"></canvas><script>import '../../scripts/poster-lab';</script></body></html>
<style is:global>
html,body{margin:0;height:100%;background:#020304;overflow:hidden}
canvas{position:fixed;inset:0;width:100vw;height:100vh;display:block}
</style>
