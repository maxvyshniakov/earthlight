---
import '../styles/global.css';
interface Props { title: string; description?: string; orbital?: boolean; immersive?: boolean; }
const {title, description = 'Explore Earth, its atmosphere and the night sky.'} = Astro.props;
---
<!doctype html>
<html lang="en" class="orbital-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020304" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to scene</a>
    <main id="main" tabindex="-1"><slot /></main>
  </body>
</html>
