---
import '../styles/global.css';
import {diagnosticsBoot} from '../scripts/diagnostics-boot';
import {diagnosticBuild} from '../../scripts/diagnostic-build.mjs';
const diagnosticScript=`(${diagnosticsBoot.toString()})(${JSON.stringify(diagnosticBuild).replaceAll('<','\\u003c')});`;
interface Props { title: string; description?: string; immersive?: boolean; }
const {title, description = 'Explore Earth, its atmosphere and the night sky.'} = Astro.props;
const site = Astro.site ?? Astro.url;
const image = new URL('/og.jpg', site).href;
const canonical = new URL(Astro.url.pathname, site).href;
---
<!doctype html>
<html lang="en" class="explorer-page">
  <head>
    <meta charset="UTF-8" />
    <script is:inline set:html={diagnosticScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Earthlight" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Green and red aurora above Earth's night side, with the Milky Way" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to scene</a>
    <main id="main" tabindex="-1"><slot /></main>
  </body>
</html>
