+/** Dirty page texels can share one upload within a row. Untouched bytes in
+ * the span come from the authoritative CPU table, including cleared slots. */
+export function terrainPageSpans(changes:number[]){
+ const rows=new Map<number,{start:number;end:number}>();
+ for(const p of changes){const row=Math.floor(p/4/800),span=rows.get(row);
+  if(span){span.start=Math.min(span.start,p);span.end=Math.max(span.end,p+4);}
+  else rows.set(row,{start:p,end:p+4});
+ }
+ return [...rows.values()];
+}
