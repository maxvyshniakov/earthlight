+test('batched terrain pages reproduce individual writes across rows and evictions',()=>{
+ const cpu=Uint8Array.from({length:800*360*4},(_,i)=>i%251+1),gpu=cpu.slice();
+ for(const changes of [[0,4,799*4,800*4,805*4,287999*4],[4,805*4,0],[]]){
+  for(const p of changes)for(let c=0;c<4;c++)cpu[p+c]=(cpu[p+c]+p/4+c+1)%256;
+  // Include a cleared former atlas entry between two live entries.
+  if(changes.length>3)cpu.fill(0,4,8);
+  const spans=terrainPageSpans(changes);
+  for(const {start,end} of spans){
+   assert.equal(Math.floor(start/3200),Math.floor((end-1)/3200),'never cross a GPU row');
+   gpu.set(cpu.subarray(start,end),start);
+  }
+  assert.deepEqual(gpu,cpu,'unchanged neighbors and deleted entries remain exact');
+  assert.equal(spans.length,new Set(changes.map(p=>Math.floor(p/3200))).size);
+ }
+});
